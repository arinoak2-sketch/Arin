# ─── Database ────────────────────────────────────────────────────────────────
# Local development (default): SQLite, no setup required.
DATABASE_URL="file:./dev.db"
# Production: any Postgres. Also switch the provider in prisma/schema.prisma.
# DATABASE_URL="postgresql://user:pass@host:5432/lumen?sslmode=require"

# ─── Auth (required in production) ───────────────────────────────────────────
# Generate with:  openssl rand -base64 32
AUTH_SECRET=""
# Google sign-in. Create at https://console.cloud.google.com/apis/credentials
#   1. APIs & Services → Credentials → Create OAuth client ID → Web application
#   2. Authorised redirect URI: http://localhost:3000/api/auth/callback/google
#      (and https://YOUR_DOMAIN/api/auth/callback/google in production)
#   3. Configure the OAuth consent screen; scopes needed: email, profile
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Dev-only email sign-in, so the app is testable before Google is configured.
# MUST be "false" in production. The app refuses to start if it is true in prod.
ALLOW_DEV_SIGNIN="true"

# ─── Live opportunity discovery (required for the core feature) ──────────────
# Create at https://brave.com/search/api/ — the free tier allows ~2,000/month.
# Without this, Lumen shows the stored corpus and states plainly that live
# discovery is unavailable. It never invents results.
BRAVE_SEARCH_API_KEY=""
# Monthly query ceiling; discovery pauses and says so rather than overrunning.
BRAVE_MONTHLY_QUERY_BUDGET="1800"

# ─── AI layer (optional — premium features only) ─────────────────────────────
# Create at https://console.anthropic.com/settings/keys
# Without this: extraction uses structured markup only, and the advisor is off.
# Match scores, checklists, deadlines and reminders NEVER depend on this key.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-opus-5"

# ─── Where this deployment lives ─────────────────────────────────────────────
# Used to build links that arrive in someone's inbox. Never derived from the
# incoming request: a request header is attacker-controlled, and a parental
# consent link built from one could be pointed at another host.
# Required in production — the app refuses to start without it.
APP_ORIGIN="http://localhost:3000"

# ─── Parental consent email (required to accept EU under-16s) ────────────────
# EU residents under 16 need a parent's permission before their data can be
# held (GDPR Art. 8). Without these, those accounts are created but stay locked
# and the admin queue lists the requests that could not be delivered. Nothing
# is faked and no operator can approve on a parent's behalf: the approval token
# is hashed at rest and cannot be recovered by anyone.
# Create at https://resend.com/api-keys
RESEND_API_KEY=""
# Must be an address on a domain you have verified with the provider.
CONSENT_EMAIL_FROM="Lumen <no-reply@yourdomain.example>"

# ─── Scheduled maintenance (optional but recommended) ────────────────────────
# Shared secret for POST /api/cron/maintenance, which expires passed deadlines
# and purges data past its retention window. Generate with:
#   openssl rand -hex 32
# The route refuses all requests when this is unset or shorter than 16 chars —
# an unauthenticated endpoint that deletes rows is worse than no endpoint.
CRON_SECRET=""
